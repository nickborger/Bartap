{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },

    "barOwners": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$bar": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".validate": "newData.isBoolean()"
        }
      }
    },

    "sessionOwners": {
      "$sid": {
        ".write": "auth != null && $sid.matches(/^[A-Za-z0-9_-]{16,40}$/) && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))"
      }
    },

    "live": {
      "$bar": {
        ".read": "auth != null",
        "$sid": {
          ".write": "auth != null && $bar.matches(/^[A-Za-z0-9_-]{1,100}$/) && (root.child('sessionOwners').child($sid).val() === auth.uid || newData.parent().parent().parent().child('sessionOwners').child($sid).val() === auth.uid)",
          ".validate": "newData.isNumber() && newData.val() <= now + 5000 && newData.val() >= now - 60000"
        }
      }
    },

    "views": {
      "$bar": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('barOwners').child($bar).child(auth.uid).val() === true)",
        "$night": {
          "$sid": {
            ".write": "auth != null && newData.exists() && $bar.matches(/^[A-Za-z0-9_-]{1,100}$/) && $night.matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/) && (root.child('sessionOwners').child($sid).val() === auth.uid || newData.parent().parent().parent().parent().child('sessionOwners').child($sid).val() === auth.uid)",
            ".validate": "newData.hasChild('s')",
            "s": {
              ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : (newData.val() <= now + 5000 && newData.val() >= now - 60000))"
            },
            "e": {
              ".validate": "newData.isNumber() && !data.exists() && newData.val() >= newData.parent().child('s').val() && newData.val() <= now + 5000 && newData.val() - newData.parent().child('s').val() <= 43200000"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },

    "counts": {
      "$bar": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('barOwners').child($bar).child(auth.uid).val() === true)",
        "$night": {
          "$metric": {
            ".write": "auth != null && newData.exists() && $bar.matches(/^[A-Za-z0-9_-]{1,100}$/) && $night.matches(/^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$/) && $metric.matches(/^(pageViews|directions|chat|social|website|calls)$/)",
            ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === 1) || (data.exists() && newData.val() === data.val() + 1))"
          }
        }
      }
    }
  }
}
