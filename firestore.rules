rules_version = '2';

// Bar Tap Firestore security rules.
// Paste into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Admins: users/{uid}.role == "admin". This role can ONLY be set in the
    // Firebase console (see FIREBASE_SETUP.md); nobody can grant it in the app.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myProfile().get('role', 'user') == 'admin';
    }

    // True if the signed-in user is linked to this bar as its owner
    // (admins link owners from the in-app Admin screen).
    function ownsBar(barId) {
      let profile = myProfile();
      return profile.get('role', 'user') in ['owner', 'admin']
        && barId in profile.get('ownedBarIds', []);
    }

    // Bar fields an owner may change on their own bar. Everything else
    // (name, address, location, photo, weekly hours, features, isActive...)
    // is admin-only.
    function ownerEditableBarFields() {
      return ['hoursToday', 'hoursTodaySetOn', 'coverCharge', 'currentDJsBand',
              'crowdDensity', 'estimatedWaitMinutes', 'websiteUrl', 'phone',
              'tagline', 'category', 'cameras', 'cameraPrivacy', 'socialLinks', 'drinkSpecials', 'events',
              'websiteVerification', 'activeFlashDeal', 'staff', 'auditLog',
              'ownerReplies', 'updatedAt', 'updatedBy'];
    }

    function validBar(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.address is string
        && data.get('isActive', true) is bool
        && validCameraFields(data)
        && validSocialLinks(data);
    }

    // Social media links on the bar page. Optional map with up to three
    // full links, each in the one tidy shape the app saves (it turns handles
    // like "@thehub" into these). Any other key or link shape is refused.
    function validSocialLinks(data) {
      return !('socialLinks' in data) || (
        data.socialLinks is map
        && data.socialLinks.keys().hasOnly(['instagram', 'tiktok', 'facebook'])
        && (!('instagram' in data.socialLinks) || (data.socialLinks.instagram is string
              && data.socialLinks.instagram.matches('https://www[.]instagram[.]com/[A-Za-z0-9._]{1,30}')))
        && (!('tiktok' in data.socialLinks) || (data.socialLinks.tiktok is string
              && data.socialLinks.tiktok.matches('https://www[.]tiktok[.]com/@[A-Za-z0-9._]{2,24}')))
        && (!('facebook' in data.socialLinks) || (data.socialLinks.facebook is string
              && data.socialLinks.facebook.size() <= 450
              && data.socialLinks.facebook.matches('https://www[.]facebook[.]com/([A-Za-z0-9.-]{1,100}(/[A-Za-z0-9.-]{1,100}){0,3}|profile[.]php[?]id=[0-9]{1,25})'))));
    }

    // Camera relay: at most 16 cameras per bar, and the privacy note is a
    // small map whose signageConfirmed is true or false. No stream keys or
    // camera passwords are ever stored here (the relay server works keys out
    // from its own secret), so the public can safely read bars.
    function validCameraFields(data) {
      return data.get('cameras', []) is list
        && data.get('cameras', []).size() <= 16
        && (!('cameraPrivacy' in data) || (
              data.cameraPrivacy is map
              && data.cameraPrivacy.keys().hasOnly(['signageConfirmed', 'confirmedBy', 'confirmedAt'])
              && data.cameraPrivacy.get('signageConfirmed', false) is bool
              && data.cameraPrivacy.get('confirmedBy', '') is string
              && data.cameraPrivacy.get('confirmedAt', '') is string));
    }

    function validScore(v) {
      return v is int && v >= 1 && v <= 5;
    }

    // ---------------------------------------------------------------
    // users/{uid}: each person reads and edits only their own profile.
    // They can never change role or ownedBarIds themselves.
    // ---------------------------------------------------------------
    match /users/{uid} {
      // Admins can look people up (by email) to link them as bar owners.
      allow read: if isSelf(uid) || isAdmin();

      allow create: if isSelf(uid)
        && request.resource.data.role == 'user'
        && request.resource.data.ownedBarIds is list
        && request.resource.data.ownedBarIds.size() == 0;

      allow update: if isSelf(uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['role', 'ownedBarIds', 'createdAt']);

      // Admins link/unlink owners: they may change only role and ownedBarIds,
      // role can only become 'user' or 'owner' (never 'admin'), and an
      // existing admin's role can't be changed from the app.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['role', 'ownedBarIds'])
        && request.resource.data.ownedBarIds is list
        && (
          (resource.data.get('role', 'user') == 'admin' && request.resource.data.role == 'admin')
          || (resource.data.get('role', 'user') != 'admin' && request.resource.data.role in ['user', 'owner'])
        );

      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // reviews/{reviewId}: anyone can read; signed-in users write only
    // their own reviews.
    // ---------------------------------------------------------------
    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.barId is string
        && request.resource.data.author is string
        && request.resource.data.author.size() <= 80
        && request.resource.data.comment is string
        && request.resource.data.comment.size() > 0
        && request.resource.data.comment.size() <= 2000
        && validScore(request.resource.data.rating)
        && validScore(request.resource.data.vibeScore)
        && validScore(request.resource.data.valueScore)
        && validScore(request.resource.data.musicScore)
        && request.resource.data.helpfulCount == 0
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.barId == resource.data.barId
        && validScore(request.resource.data.rating);

      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---------------------------------------------------------------
    // bars/{barId}: the bar listings. Anyone can read. Admins create,
    // edit, hide and delete bars. A bar's owner can update only the
    // live fields in ownerEditableBarFields() on their own bar.
    // ---------------------------------------------------------------
    match /bars/{barId} {
      allow read: if true;

      allow create: if isAdmin() && validBar(request.resource.data);
      allow update: if isAdmin() && validBar(request.resource.data);
      allow delete: if isAdmin();

      allow update: if signedIn() && ownsBar(barId)
        && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(ownerEditableBarFields())
        && validCameraFields(request.resource.data)
        && validSocialLinks(request.resource.data);

      // -------------------------------------------------------------
      // Live chat: one room per bar, next to the live video.
      // Anyone can read. You must be signed in to post. Messages carry
      // expiresAt (the bar's closing time tonight); the app hides them
      // after that and Firestore's TTL policy deletes them.
      // -------------------------------------------------------------
      match /chat/{msgId} {
        allow read: if true;

        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'role', 'createdAt', 'expiresAt'])
          && request.resource.data.uid == request.auth.uid
          && validChatName(request.resource.data.name)
          && validChatText(request.resource.data.text)
          && validChatRole(barId, request.resource.data.role)
          && request.resource.data.createdAt == request.time
          && validChatExpiry(request.resource.data.expiresAt)
          && !isChatMuted(barId)
          // Slow mode: the same write must stamp your chatUsers record with
          // this message (that record's own rule enforces the gap).
          && getAfter(chatUserPath(barId, request.auth.uid)).data.lastMsgId == msgId
          && getAfter(chatUserPath(barId, request.auth.uid)).data.lastPostAt == request.time;

        // Messages can't be edited.
        allow update: if false;

        // Your own message, or the bar's owner / an admin moderating.
        allow delete: if signedIn()
          && (isChatModerator(barId) || resource.data.uid == request.auth.uid);
      }

      // Per-person chat state in this bar: slow mode and "muted tonight".
      match /chatUsers/{uid} {
        allow read: if isSelf(uid) || isChatModerator(barId);

        // Slow mode stamp, written together with each message you post.
        allow create: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['lastPostAt', 'lastMsgId', 'expiresAt'])
          && validSlowStamp(barId);
        allow update: if isSelf(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['lastPostAt', 'lastMsgId', 'expiresAt'])
          && !(resource.data.get('mutedUntil', null) is timestamp
               && resource.data.mutedUntil > request.time)
          && (!('lastPostAt' in resource.data)
              || request.time >= resource.data.lastPostAt + duration.value(5, 's'))
          && validSlowStamp(barId);

        // Owner / admin: mute for the night (or lift a mute).
        allow create: if isChatModerator(barId) && !isSelf(uid)
          && request.resource.data.keys().hasOnly(['mutedUntil', 'mutedBy', 'expiresAt'])
          && validMute();
        allow update: if isChatModerator(barId) && !isSelf(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['mutedUntil', 'mutedBy', 'expiresAt'])
          && validMute();

        allow delete: if false;
      }
    }

    // ---------------------------------------------------------------
    // Live chat helpers
    // ---------------------------------------------------------------
    function chatUserPath(barId, uid) {
      return /databases/$(database)/documents/bars/$(barId)/chatUsers/$(uid);
    }

    function isChatModerator(barId) {
      return isAdmin() || ownsBar(barId);
    }

    function validChatName(n) {
      return n is string && n.size() > 0 && n.size() <= 40;
    }

    // 1-300 characters, and no links (the app also filters slurs, emails
    // and phone numbers before sending).
    function validChatText(t) {
      return t is string && t.size() > 0 && t.size() <= 300
        && !t.lower().matches('.*(https?://|www[.]).*')
        && !t.lower().matches('.*[a-z0-9-][.](com|net|org|io|app|gg|ly|xyz)([/ ].*)?');
    }

    // The copper owner badge and the admin badge can't be faked.
    function validChatRole(barId, role) {
      return role == 'user'
        || (role == 'owner' && ownsBar(barId))
        || (role == 'admin' && isAdmin());
    }

    // Closing time tonight: in the future, and at most 30 hours away.
    function validChatExpiry(e) {
      return e is timestamp
        && e > request.time
        && e <= request.time + duration.value(30, 'h');
    }

    function isChatMuted(barId) {
      let path = chatUserPath(barId, request.auth.uid);
      return exists(path)
        && get(path).data.get('mutedUntil', null) is timestamp
        && get(path).data.mutedUntil > request.time;
    }

    function validSlowStamp(barId) {
      return request.resource.data.lastPostAt == request.time
        && request.resource.data.lastMsgId is string
        && existsAfter(/databases/$(database)/documents/bars/$(barId)/chat/$(request.resource.data.lastMsgId))
        && validChatExpiry(request.resource.data.expiresAt);
    }

    function validMute() {
      return request.resource.data.mutedUntil is timestamp
        && request.resource.data.mutedUntil <= request.time + duration.value(30, 'h')
        && request.resource.data.mutedBy == request.auth.uid
        && request.resource.data.get('expiresAt', null) is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(30, 'h');
    }

    // ---------------------------------------------------------------
    // chatReports/{reportId}: "Report" on a chat message. Anyone signed
    // in can report; only admins and that bar's owner can read or
    // resolve reports. Reporters can't read reports back.
    // ---------------------------------------------------------------
    match /chatReports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['barId', 'barName', 'messageId', 'reportedUid',
              'reportedName', 'text', 'reason', 'reporterUid', 'status', 'createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reportedUid != request.auth.uid
        && request.resource.data.barId is string
        && request.resource.data.barName is string && request.resource.data.barName.size() <= 120
        && request.resource.data.messageId is string
        && request.resource.data.reportedUid is string
        && request.resource.data.reportedName is string && request.resource.data.reportedName.size() <= 40
        && request.resource.data.text is string && request.resource.data.text.size() <= 300
        && request.resource.data.reason in ['harassment', 'hate', 'sexual', 'spam', 'personal_info', 'other']
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;

      allow read, delete: if isAdmin()
        || (signedIn() && ownsBar(resource.data.barId));
      allow update: if false;
    }

    // ---------------------------------------------------------------
    // config/{docId}: app settings (config/seed marks that the built-in
    // bars were copied into Firestore). Anyone reads, admins write.
    // ---------------------------------------------------------------
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // ownerRequests/{uid}: "link my venue" requests. Admins review them
    // in the app's Admin screen (Owners tab).
    // ---------------------------------------------------------------
    match /ownerRequests/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, update: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending';
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'approvedBarId', 'reviewedBy', 'reviewedAt'])
        && request.resource.data.status in ['approved', 'declined'];
      allow delete: if isAdmin();
    }
  }
}
