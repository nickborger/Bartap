rules_version = '2';

// Bar Tap Firestore security rules.
// Paste into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // True if the signed-in user is an owner linked to this bar
    // (role and ownedBarIds can only be set from the Firebase console).
    function ownsBar(barId) {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return profile.role == 'owner' && barId in profile.ownedBarIds;
    }

    function validScore(v) {
      return v is int && v >= 1 && v <= 5;
    }

    // ---------------------------------------------------------------
    // users/{uid}: each person reads and edits only their own profile.
    // They can never change role, isPremium or ownedBarIds themselves.
    // ---------------------------------------------------------------
    match /users/{uid} {
      allow read: if isSelf(uid);

      allow create: if isSelf(uid)
        && request.resource.data.role == 'user'
        && request.resource.data.isPremium == false
        && request.resource.data.ownedBarIds is list
        && request.resource.data.ownedBarIds.size() == 0;

      allow update: if isSelf(uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['role', 'isPremium', 'ownedBarIds', 'createdAt']);

      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // reviews/{reviewId}: anyone can read; signed-in users write only
    // their own reviews.
    // ---------------------------------------------------------------
    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.barId is string
        && request.resource.data.author is string
        && request.resource.data.author.size() <= 80
        && request.resource.data.comment is string
        && request.resource.data.comment.size() > 0
        && request.resource.data.comment.size() <= 2000
        && validScore(request.resource.data.rating)
        && validScore(request.resource.data.vibeScore)
        && validScore(request.resource.data.valueScore)
        && validScore(request.resource.data.musicScore)
        && request.resource.data.helpfulCount == 0
        && request.resource.data.createdAt == request.time;

      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.barId == resource.data.barId
        && validScore(request.resource.data.rating);

      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---------------------------------------------------------------
    // bars/{barId}: owner edits (hours, cover, drink specials, deals,
    // replies to reviews). Anyone can read; only that bar's owner writes.
    // ---------------------------------------------------------------
    match /bars/{barId} {
      allow read: if true;
      allow write: if signedIn() && ownsBar(barId);
    }

    // ---------------------------------------------------------------
    // ownerRequests/{uid}: "link my venue" requests. The admin reviews
    // them in the Firebase console.
    // ---------------------------------------------------------------
    match /ownerRequests/{uid} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending';
      allow delete: if false;
    }
  }
}
