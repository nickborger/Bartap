rules_version = '2';

// Bar Tap Cloud Storage security rules (only needed if you enable Storage for bar photos).
// Paste into Firebase console > Storage > Rules, then Publish.
service firebase.storage {
  match /b/{bucket}/o {

    // Bar photos: anyone can view them; only admins (users/{uid}.role == "admin"
    // in Firestore) can upload, and only images under 5 MB.
    match /bars/{barKey}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && (request.resource == null
            || (request.resource.size < 5 * 1024 * 1024
                && request.resource.contentType.matches('image/.*')));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
